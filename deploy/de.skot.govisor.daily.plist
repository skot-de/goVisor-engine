<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.skot.govisor.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/svko_macmini/PROJEKTE/claude_code/C09_govisor/scripts/daily_leads.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/svko_macmini/PROJEKTE/claude_code/C09_govisor</string>

    <!-- launchd startet mit minimalem PATH → Python-Framework + Standardpfade explizit setzen -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Zwei Läufe täglich: 13:00 (Vormittags-/Mittagswelle, ~60% des Tages veröffentlicht) und
         22:00 (Tagesrest, ~100%). Gemessen an cbc:IssueTime der DÖE-eForms (Bürotag-Verteilung).
         Verpasst der Mac einen Slot (aus/schlafend), holt launchd ihn beim nächsten Wachwerden nach.
         Der mkdir-Lock im Script verhindert Überlappung; der Monats-Refetch fängt jede Verzögerung auf. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- Frühe launchd-Fehler (vor dem Script-eigenen Log) landen hier -->
    <key>StandardOutPath</key>
    <string>/Users/svko_macmini/PROJEKTE/claude_code/C09_govisor/data/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/svko_macmini/PROJEKTE/claude_code/C09_govisor/data/logs/launchd.err.log</string>
</dict>
</plist>
